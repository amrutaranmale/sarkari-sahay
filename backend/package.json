{
  "name": "sarkari-sahay-backend",
  "version": "1.0.0",
  "description": "SarkariSahay API — Government Scheme Finder for India",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node src/seed/schemes.seed.js",
    "db:setup": "prisma db push && node src/seed/schemes.seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
